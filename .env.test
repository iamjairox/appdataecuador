APP_ENV=test

DB_HOST=localhost
DB_PORT=5432
DB_NOMBRE=govdata_test
DB_USUARIO=govdata
DB_PASSWORD=govdata
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=0
DB_ECHO_SQL=false

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=govdata
MINIO_SECRET_KEY=govdata123
MINIO_BUCKET=documentos-transparencia-test
MINIO_USAR_SSL=false

PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=15000
PLAYWRIGHT_NAVEGADOR=chromium

SCRAPING_URL_BASE_DPE=https://transparencia.dpe.gob.ec/entidades
SCRAPING_CONCURRENCIA_MAXIMA=1
SCRAPING_MAX_REINTENTOS=1
SCRAPING_BACKOFF_BASE_SEGUNDOS=0.1
SCRAPING_INTERVALO_MINIMO_SEGUNDOS=0.01
SCRAPING_ANIOS_LOOKBACK_MAXIMO=3
SCRAPING_UMBRAL_CONFIANZA_ITEM=70.0
SCRAPING_UMBRAL_CONFIANZA_ARCHIVO=80.0
SCRAPING_URL_ORIGEN_DPE=https://transparencia.dpe.gob.ec

# --- Descarga (Modulo 3) ---
DOWNLOAD_CONCURRENCIA_MAXIMA=4
DOWNLOAD_TIMEOUT_SEGUNDOS=5.0
DOWNLOAD_MAX_REINTENTOS=2
DOWNLOAD_BACKOFF_BASE_SEGUNDOS=0.05
DOWNLOAD_TAMANO_MAXIMO_BYTES=104857600
DOWNLOAD_MINUTOS_LIBERAR_ESTANCADOS=30
DOWNLOAD_LIMITE_LOTE=100

# --- Storage ---
STORAGE_BACKEND=local
STORAGE_RUTA_LOCAL=data/documentos

LOG_NIVEL=WARNING
LOG_FORMATO_JSON=false
LOG_RUTA_ARCHIVO=logs/govdata-test.log

# --- API REST (Modulo 10) ---
APP_HOST=127.0.0.1
APP_PORT=8001
API_KEY=
CORS_ORIGINS=*
RATE_LIMIT_POR_MINUTO=1000
RATE_LIMIT_PAGINA_MAXIMA=100
