# Copiar a .env.development / .env.test / .env.production segun el entorno.
# APP_ENV determina cual de estos archivos se carga automaticamente.
APP_ENV=development

# --- Base de datos ---
DB_HOST=localhost
DB_PORT=5432
DB_NOMBRE=govdata
DB_USUARIO=govdata
DB_PASSWORD=govdata
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_ECHO_SQL=false

# --- Redis (cola) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- MinIO (storage de documentos) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=govdata
MINIO_SECRET_KEY=govdata123
MINIO_BUCKET=documentos-transparencia
MINIO_USAR_SSL=false

# --- Playwright ---
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=30000
PLAYWRIGHT_NAVEGADOR=chromium

# --- Scraping ---
SCRAPING_URL_BASE_DPE=https://transparencia.dpe.gob.ec/entidades
SCRAPING_CONCURRENCIA_MAXIMA=4
SCRAPING_MAX_REINTENTOS=3
SCRAPING_BACKOFF_BASE_SEGUNDOS=2.0
SCRAPING_INTERVALO_MINIMO_SEGUNDOS=1.0
SCRAPING_ANIOS_LOOKBACK_MAXIMO=3
SCRAPING_UMBRAL_CONFIANZA_ITEM=70.0
SCRAPING_UMBRAL_CONFIANZA_ARCHIVO=80.0
SCRAPING_URL_ORIGEN_DPE=https://transparencia.dpe.gob.ec

# --- Descarga (Modulo 3) ---
DOWNLOAD_CONCURRENCIA_MAXIMA=4
DOWNLOAD_TIMEOUT_SEGUNDOS=30.0
DOWNLOAD_MAX_REINTENTOS=3
DOWNLOAD_BACKOFF_BASE_SEGUNDOS=2.0
DOWNLOAD_TAMANO_MAXIMO_BYTES=104857600
DOWNLOAD_MINUTOS_LIBERAR_ESTANCADOS=30
DOWNLOAD_LIMITE_LOTE=100

# --- Storage ---
STORAGE_BACKEND=local
STORAGE_RUTA_LOCAL=data/documentos

# --- Logging ---
LOG_NIVEL=INFO
LOG_FORMATO_JSON=false
LOG_RUTA_ARCHIVO=logs/govdata.log

# --- API REST (Modulo 10) ---
APP_HOST=0.0.0.0
APP_PORT=8000
# API_KEY vacio deshabilita la verificacion (solo development). En
# production DEBE configurarse via variable de entorno real, nunca aqui.
API_KEY=
CORS_ORIGINS=*
RATE_LIMIT_POR_MINUTO=120
RATE_LIMIT_PAGINA_MAXIMA=100

# --- Acceso compartido ---
# Generar con: python scripts/generar_credenciales_acceso.py --usuario dataok
# En producción es obligatorio activar y configurar este acceso.
# Los valores reales deben guardarse como secretos del servidor, nunca en Git.
ACCESS_ENABLED=false
ACCESS_USUARIO=
ACCESS_CLAVE_HASH=
ACCESS_SECRETO=
ACCESS_DURACION_HORAS=12

# Rechazo automatico local ante CAPTCHA o challenge
SCRAPING_RECHAZAR_CAPTCHA_ANTIBOT=false
