APP_ENV=development

DB_HOST=localhost
DB_PORT=5433
DB_NOMBRE=govdata_dev
DB_USUARIO=govdata
DB_PASSWORD=govdata
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
DB_ECHO_SQL=true

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=govdata
MINIO_SECRET_KEY=govdata123
