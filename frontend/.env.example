# Copiar a .env.local (Vite lo carga automaticamente y .gitignore ya lo excluye).
# URL base de la API GovData (Modulo 10). Sin barra final.
VITE_API_URL=http://localhost:8000

# Opcional: solo necesaria si el backend tiene API_KEY configurada
