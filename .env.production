# PLANTILLA de produccion -- reemplazar TODOS los valores antes de desplegar.
# Este archivo se versiona solo como plantilla; los valores reales de
# produccion deben inyectarse via secretos del orquestador (Docker/K8s),
# nunca commitear credenciales reales aqui.
APP_ENV=production

DB_HOST=postgres
DB_PORT=5432
DB_NOMBRE=govdata
DB_USUARIO=CAMBIAR_ME
DB_PASSWORD=CAMBIAR_ME
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_ECHO_SQL=false

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CAMBIAR_ME
MINIO_SECRET_KEY=CAMBIAR_ME
MINIO_BUCKET=documentos-transparencia
MINIO_USAR_SSL=true

PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=30000
PLAYWRIGHT_NAVEGADOR=chromium

SCRAPING_URL_BASE_DPE=https://transparencia.dpe.gob.ec/entidades
SCRAPING_CONCURRENCIA_MAXIMA=4
SCRAPING_MAX_REINTENTOS=3
SCRAPING_BACKOFF_BASE_SEGUNDOS=2.0
SCRAPING_INTERVALO_MINIMO_SEGUNDOS=1.0
SCRAPING_ANIOS_LOOKBACK_MAXIMO=3
SCRAPING_UMBRAL_CONFIANZA_ITEM=70.0
SCRAPING_UMBRAL_CONFIANZA_ARCHIVO=80.0
SCRAPING_URL_ORIGEN_DPE=https://transparencia.dpe.gob.ec

# --- Descarga (Modulo 3) ---
DOWNLOAD_CONCURRENCIA_MAXIMA=4
DOWNLOAD_TIMEOUT_SEGUNDOS=30.0
DOWNLOAD_MAX_REINTENTOS=3
DOWNLOAD_BACKOFF_BASE_SEGUNDOS=2.0
DOWNLOAD_TAMANO_MAXIMO_BYTES=104857600
DOWNLOAD_MINUTOS_LIBERAR_ESTANCADOS=30
DOWNLOAD_LIMITE_LOTE=100

# --- Storage ---
STORAGE_BACKEND=local
STORAGE_RUTA_LOCAL=data/documentos

LOG_NIVEL=INFO
LOG_FORMATO_JSON=true
LOG_RUTA_ARCHIVO=logs/govdata.log

# --- API REST (Modulo 10) ---
APP_HOST=0.0.0.0
APP_PORT=8000
API_KEY=CAMBIAR_ME
CORS_ORIGINS=https://CAMBIAR_ME.example.com
RATE_LIMIT_POR_MINUTO=60
RATE_LIMIT_PAGINA_MAXIMA=100
